# Optional provider configuration. No variables are required for offline tests.
# Copy this file to .env only if .env does not already exist. Never commit .env.
# Defaults and provider requirements: docs/DEVELOPMENT_ENVIRONMENT.md
NEWSAPI_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=
OLLAMA_HOST=
OLLAMA_LOCAL_MODEL=
# OLLAMA_LOCAL_OPTIONS={"num_gpu":0}  # use only when GPU inference fails
OLLAMA_CLOUD_MODEL=
OLLAMA_API_KEY=
MOONSHOT_API_KEY=
KIMI_API_KEY=
MOONSHOT_MODEL=
KIMI_MODEL=
# Keep these UNSET unless supplying valid values; empty PORT is invalid.
# HOST=
# PORT=

# Read-only IG discovery. IG_IDENTIFIER is the API login username, not email or account ID.
IG_API_KEY=
IG_IDENTIFIER=
# IG_USERNAME=  # backward-compatible alias when IG_IDENTIFIER is unset
IG_PASSWORD=
IG_ACCOUNT_ID=
IG_ENVIRONMENT=DEMO
